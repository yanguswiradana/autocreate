# Provider AI Teks: "auto" (Gemini dulu, fallback ke OpenCode Go), "gemini", atau "opencode"
AI_PROVIDER=auto

# Wajib untuk AI Content Director (Teks & Storyboard)
GEMINI_API_KEY=your_gemini_api_key_here

# Model teks Gemini (default: gemini-3.8-flash)
GEMINI_TEXT_MODEL=gemini-3.8-flash

# Fallback: OpenCode Go (OpenAI-compatible)
OPENCODE_API_KEY=your_opencode_api_key_here
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=glm-5.3-flash

# Visual Provider: "procedural" (gratis offline), "wikimedia" (foto gratis tanpa API key), "unsplash" (gratis via Access Key), "gemini" (butuh billing/kuota image), atau "pexels"
VISUAL_PROVIDER=procedural

# Opsional jika VISUAL_PROVIDER=unsplash (daftar gratis di unsplash.com/developers)
UNSPLASH_ACCESS_KEY=

# Opsional jika VISUAL_PROVIDER=gemini
GEMINI_IMAGE_MODEL=imagen-3.0-generate-002

# Opsional jika VISUAL_PROVIDER=pexels (daftar gratis di pexels.com/api)
PEXELS_API_KEY=

# Suara Edge-TTS gratis untuk voiceover video (misal: id-ID-ArdiNeural atau id-ID-GadisNeural)
TTS_VOICE=id-ID-ArdiNeural
